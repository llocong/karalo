# Gradle
.gradle/
build/
*/build/
gradle-app.setting
!gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Local configuration
local.properties
**/local.properties

# Android Studio / IntelliJ
.idea/
*.iml
*.ipr
*.iws
.navigation/
captures/
.externalNativeBuild/
.cxx/

# Android
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
# NOT "release/": an old Eclipse-ADT-era default (alongside bin/gen/out above), meaningless for a
# Gradle project (build output already lives under build/, ignored above) -- but its unanchored
# form matched *any* directory named "release" anywhere in the tree, which silently swallowed
# app/src/release/, a real AGP variant source set (holds the committed Baseline Profile -- see
# :baselineprofile module and CONTRIBUTING.md "Performance").

# Signing / secrets — NEVER commit these
*.jks
*.keystore
keystore.properties
**/keystore.properties
# app/google-services.json is intentionally NOT ignored: it's a checked-in placeholder so the
# build works with zero setup (see docs/firebase-setup.md). If you replace it locally with your
# real Firebase config, do not `git add`/commit that change.

# macOS
.DS_Store

# Log files
*.log

# Kotlin
.kotlin/

# ktlint / detekt reports
**/reports/

# Coverage
**/coverage/

# NDK
.externalNativeBuild
.cxx

# VS Code
.vscode/

# Fastlane / misc CI artifacts
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
