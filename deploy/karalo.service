# systemd unit for the Karalo backend. Installed to /etc/systemd/system/karalo.service by
# deploy/setup-server.sh. Secrets and the hostname live in /etc/karalo/karalo.env, not here.
[Unit]
Description=Karalo karaoke backend
After=network-online.target
Wants=network-online.target

[Service]
User=karalo
Group=karalo
WorkingDirectory=/var/lib/karalo
EnvironmentFile=/etc/karalo/karalo.env
Environment=KARALO_HOST=127.0.0.1
Environment=KARALO_PORT=8080
Environment=KARALO_DB_PATH=/var/lib/karalo/karalo-backend.db
Environment=KARALO_TRUST_PROXY=true
# The e2-micro VM has 1 GB of RAM; cap the heap so the JVM, Caddy and the OS all fit.
Environment=JAVA_OPTS=-Xmx320m -XX:+UseSerialGC
ExecStart=/opt/karalo/bin/karalo-backend
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
