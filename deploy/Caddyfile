# Caddy gets and renews the HTTPS certificate for this hostname on its own, and passes WebSocket
# upgrades through to the backend. deploy/setup-server.sh and deploy/deploy.sh replace
# KARALO_HOSTNAME.
KARALO_HOSTNAME {
	encode zstd gzip

	# Let browsers keep static files instead of downloading them on every visit. Fonts never
	# change under the same name; images might, so they're kept for a week.
	@fonts path /fonts/*.woff2
	header @fonts Cache-Control "public, max-age=31536000, immutable"
	@images path /images/*
	header @images Cache-Control "public, max-age=604800"

	# The TV app for friends to install, put there by deploy/publish-apk.sh. karalo.app/download
	# goes straight to the current APK, so it's all there is to type into Downloader on a TV.
	redir /download /download/karalo.apk
	redir /download/ /download/karalo.apk
	handle /download/* {
		root * /srv/karalo
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		# karalo.apk and latest.json always name the newest release; versioned APKs never change.
		@current path /download/karalo.apk /download/latest.json
		header @current Cache-Control "no-cache"
		@versioned path_regexp ^/download/karalo-[0-9][^/]*\.apk$
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8080
	}
}
